# Copia questo file in `.env` e personalizza i valori.
# Il file .env è ignorato da git: NON committare credenziali reali.

# --- Infrastruttura -----------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
QDRANT_URL=http://qdrant:6333
MYSQL_ROOT_PASSWORD=root
MYSQL_PASSWORD=sdlc
LOG_LEVEL=info

# --- Sicurezza ----------------------------------------------------------
JWT_SECRET=change-me-in-production
# Chiave per le chiamate machine-to-machine (n8n, servizio->servizio).
# n8n deve inviare l'header: X-Internal-Api-Key: <valore>
INTERNAL_API_KEY=dev-internal-key
# Passphrase per cifrare a riposo i token Git per-repository (Ingestion & Sync).
SETTINGS_ENC_KEY=change-me-in-production

# --- LLM (Ollama on-premise o endpoint compatibile) ----------------------
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Agente cloud esterno (scrive il codice e pusha su wo/<id>) -----------
# Webhook che riceve il JSON di handoff del Work Order. Vuoto = nessun invio.
# Per usare il workflow n8n "Agente di Coding cloud (Gemini)":
CLOUD_AGENT_URL=http://n8n:5678/webhook/cloud-coding-agent
# Chiave API Google Gemini usata dall'agente di coding n8n per generare il codice.
GEMINI_API_KEY=
# Token GitHub con permessi di scrittura sul repository bersaglio (branch, commit, PR).
GITHUB_TOKEN=

# --- Integrazioni esterne (Ingestion & Sync Service) ---------------------
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API=
JIRA_PROJECT_KEY=SCRUM

# --- Modello LLM --------------------------------------------------------
LLM_MODEL=qwen2.5:3b
# Provider dedotto dal nome del modello (claude-* -> anthropic, altrimenti ollama).
# Per forzarlo: LLM_PROVIDER=ollama | anthropic
LLM_PROVIDER=
ANTHROPIC_API_KEY=

# --- Dashboard Grafana --------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
